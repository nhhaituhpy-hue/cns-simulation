{
  "name": "cns-simulator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "npm run clean:cache && next dev",
    "clean:cache": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "db:dev:up": "docker compose --env-file .env.local -f compose.database.dev.yml up -d",
    "db:dev:down": "docker compose --env-file .env.local -f compose.database.dev.yml down",
    "db:migrate": "node scripts/run-database-migrations.mjs",
    "media:guides": "node scripts/generate-guidance-media.mjs",
    "media:upload:v3": "node scripts/upload-training-media.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "ai:worker:build": "node scripts/build-ai-worker.mjs",
    "ai:worker:start": "node dist-ai-worker/entry.mjs"
  },
  "dependencies": {
    "@next/env": "^16.4.6",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^11.14.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.1",
    "fflate": "^0.8.3",
    "geist": "^1.9.2",
    "mammoth": "^1.13.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unpdf": "^1.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33",
      "sharp": "0.35.5"
    }
  }
}
