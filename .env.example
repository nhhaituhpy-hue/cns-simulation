# Legacy Supabase configuration. Keep only while the migration is in progress.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only key used for login lockout bookkeeping. Never prefix this with NEXT_PUBLIC_.
# In Supabase: Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Optional direct database connection used only by migration tooling.
# SUPABASE_DB_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Target PostgreSQL configuration.
# The POSTGRES_* variables are used only by compose.database.dev.yml.
POSTGRES_DB=cns_simulator
POSTGRES_USER=cns_simulator
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_PORT=5433

# Next.js uses DATABASE_URL at runtime. URL-encode special characters in passwords.
DATABASE_URL=postgresql://cns_simulator:replace-with-a-local-only-password@127.0.0.1:5433/cns_simulator

# Optional migration connection. When omitted, db:migrate falls back to DATABASE_URL.
# Production should use a separate migration role here.
# DATABASE_ADMIN_URL=postgresql://migration_user:<url-encoded-password>@database-host:5432/cns_simulator

DATABASE_POOL_MAX=5
DATABASE_SSL=false

# Migration-only secret. Supply it immediately before creating migrated users,
# then remove it from the environment. Never commit the real value.
# TEMP_INITIAL_PASSWORD=
