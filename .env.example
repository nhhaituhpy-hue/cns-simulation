# Supabase public client configuration.
# These values are safe to expose to the browser when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only key used for login lockout bookkeeping. Never prefix this with NEXT_PUBLIC_.
# In Supabase: Project Settings > API Keys > Secret keys.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Optional direct database connection used only by migration tooling.
# SUPABASE_DB_URL=postgresql://postgres:<url-encoded-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
